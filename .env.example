# Postgres connection string (Neon / Vercel Postgres / any Postgres provider)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend (https://resend.com) API key used to auto-send confirmation emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address. Until you verify your own domain on Resend, you can use
# the shared "onboarding@resend.dev" address for testing.
EMAIL_FROM="onboarding@resend.dev"

# Shared password for the admin backend at /admin
ADMIN_PASSWORD="change-me"

# Random secret used to sign admin login sessions. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"
